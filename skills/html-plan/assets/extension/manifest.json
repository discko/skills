{
  "manifest_version": 3,
  "name": "HTML Plan — Local Save",
  "version": "0.3.1",
  "description": "将本地 HTML Plan 的审阅反馈保存回当前文件。",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["file:///*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}],
  "action": {"default_popup": "popup.html", "default_title": "HTML Plan 连接状态"}
}
